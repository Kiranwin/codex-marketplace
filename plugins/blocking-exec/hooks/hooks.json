{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$PLUGIN_ROOT/hooks/blocking_exec.py\"",
            "timeout": 1200,
            "statusMessage": "Running command to completion"
          }
        ]
      }
    ]
  }
}
